{
  "$schema": "./tools/oxc/npm/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "scriptc"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "tools/**",
    "vendor/**",
    "msvc-probe/**",
    "scriptc-runtime-sys/**",
    "docs/**",
    "tests/test262/**",
    "tests/diagnostics/**",
    "tests/corpus/1831-enum-string-const-reverse.ts",
    "tests/corpus/1822-static-block-js.js",
    "tests/corpus/2674-top-level-for-await-implicit-module.ts"
  ],
  "rules": {
    "scriptc/corpus-no-nondeterminism": "warn",
    "scriptc/corpus-no-bare-imports": "error",
    "scriptc/colocated-test-naming": "warn",
    "scriptc/no-explicit-any": "warn",
    "scriptc/no-fenced-globals": "warn",
    "scriptc/no-date-fenced-usage": "error",
    "scriptc/no-commonjs-metadata-mutation": "error",
    "scriptc/no-computed-dynamic-import": "warn",
    "scriptc/promise-all-inline-tuple": "warn",
    "scriptc/no-locale-compare": "warn",
    "scriptc/no-process-exitcode-misuse": "error",
    "no-console": "off",
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": [
        "packages/**",
        "scripts/**",
        "tests/harness/**",
        "tests/fixtures/**",
        "tests/coverage-fixtures/**",
        "**/*.d.ts"
      ],
      "rules": {
        "scriptc/no-explicit-any": "off",
        "scriptc/no-fenced-globals": "off",
        "scriptc/no-date-fenced-usage": "off",
        "scriptc/no-commonjs-metadata-mutation": "off",
        "scriptc/no-computed-dynamic-import": "off",
        "scriptc/promise-all-inline-tuple": "off",
        "scriptc/no-locale-compare": "off",
        "scriptc/no-process-exitcode-misuse": "off"
      }
    },
    {
      "files": ["tests/corpus/**"],
      "rules": {
        "scriptc/no-explicit-any": "off",
        "scriptc/no-fenced-globals": "off",
        "scriptc/promise-all-inline-tuple": "off",
        "scriptc/no-locale-compare": "off",
        "scriptc/no-date-fenced-usage": "error",
        "scriptc/no-commonjs-metadata-mutation": "error",
        "scriptc/no-computed-dynamic-import": "warn",
        "scriptc/no-process-exitcode-misuse": "error"
      }
    }
  ]
}
